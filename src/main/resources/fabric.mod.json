{
	"schemaVersion": 1,
	"id": "soullink",
	"version": "${version}",
	"name": "Soul Link",
	"description": "Linked players share one inventory (main, hotbar, armor and offhand), hunger, health and experience in real time. Link everyone or split players into groups (2 and 2, or however you like). Tracks attempts and whose fault each death was (/soullink). Server-side: vanilla clients can join.",
	"authors": [
		"FacuBas"
	],
	"contact": {
		"homepage": "https://github.com/Facu-Basualdo/SoulLink",
		"sources": "https://github.com/Facu-Basualdo/SoulLink",
		"issues": "https://github.com/Facu-Basualdo/SoulLink/issues"
	},
	"license": "MIT",
	"icon": "assets/soullink/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.soullink.SoulLink"
		],
		"modmenu": [
			"com.soullink.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"soullink.mixins.json",
		"soullink.trinkets.mixins.json"
	],
	"suggests": {
		"trinkets": "*"
	},
	"breaks": {
		"herosforge": "<0.14.0"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
